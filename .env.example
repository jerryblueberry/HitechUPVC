# Canonical production origin (no trailing slash) — used for sitemap, OG, JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Google Tag Manager container (GA4 / Ads configured inside GTM)
NEXT_PUBLIC_GTM_ID=GTM-5TP729V4

# Optional: Google Search Console HTML tag verification token
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
